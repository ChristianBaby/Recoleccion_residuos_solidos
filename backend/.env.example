# ── Base de datos (PostgreSQL local o gestionada en Dokploy) ───────────────────
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# ── Servidor ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── Frontend (URL desplegada — sin barra final) ────────────────────────────────
# Para múltiples orígenes separar con coma:
FRONTEND_URL=https://sistemarss.ecosdelseo.com

# ── JWT (genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))") ──
JWT_ACCESS_SECRET=cambia_esto_por_un_secreto_seguro_de_64_caracteres
JWT_REFRESH_SECRET=cambia_esto_por_otro_secreto_seguro_de_64_caracteres
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Correos transaccionales por Brevo (verificación, recuperación, retrasos) ───
# Sin BREVO_API_KEY los correos se imprimen en consola (modo desarrollo)
BREVO_API_KEY=tu_api_key_de_brevo
EMAIL_FROM=EcoRutas Cusco <noreply@ecorutas.pe>

# RF-17: Notificaciones Web Push (generar con: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@tudominio.pe
